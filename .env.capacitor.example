# Capacitor iOS/Android 本機測試包（複製為 .env.capacitor）
# npm run build:ios 會執行 vite build --mode capacitor，自動載入此檔
#
# ⚠️ App Store Archive 請改用：
#   npm run build:ios:release
# 並確保 VITE_ENABLE_DEV_MODE 不存在或不是 true

# 開發模式（首頁「今日推薦」連點 7 次）— 真機測試用
VITE_ENABLE_DEV_MODE=true

# 開發用 UI（僅 vite dev + true）；上架 / Archive 必須 false
VITE_LOVEQUEST_DEBUG_NOTIFICATIONS=false

# WebView 為 https://lovequest.app，/api/* 必須打 Vercel
VITE_LOVEQUEST_API_ORIGIN=https://couple-rpg-app.vercel.app

# Apple 登入（Supabase Auth → Providers → Apple；Redirect: lovequest://auth/callback）
VITE_APPLE_OAUTH_ENABLED=true
